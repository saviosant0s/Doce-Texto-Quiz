text = "O QUE É O DOCE TEXTO QUIZ?"

[node name="TextoOQue" type="Label" parent="Margem/Coluna/Linha/Painel/Conteudo"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_type_variation = &"Texto"
theme_override_font_sizes/font_size = 20
text = "Um quiz lúdico, interativo e pedagógico que verifica o conhecimento dos alunos sobre as principais funcionalidades dos softwares de edição de documentos e planilhas eletrônicas. Cada nível tem questões de múltipla escolha com diferentes graus de complexidade, tempo para responder e o resultado ao final."
autowrap_mode = 3

[node name="Numeros" type="HBoxContainer" parent="Margem/Coluna/Linha/Painel/Conteudo"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="TituloQuem" type="Label" parent="Margem/Coluna/Linha/Painel/Conteudo"]
layout_mode = 2
