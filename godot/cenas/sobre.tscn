theme_override_font_sizes/font_size = 32
text = "QUEM FEZ"

[node name="TextoQuem" type="Label" parent="Margem/Coluna/Linha/Painel/Conteudo"]
custom_minimum_size = Vector2(200, 0)
layout_mode = 2
theme_type_variation = &"Texto"
theme_override_font_sizes/font_size = 20
text = "Criado em 2023 por Sávio Santos, Talita e Natalí, alunos do primeiro ano de Informática do IFBA Campus Valença, com orientação dos professores Eduardo Cambruzzi, Peterson Lobato, Alba Rogéria, Nelson Valente e Cristian Lins."
autowrap_mode = 3

[node name="Espaco" type="Control" parent="Margem/Coluna/Linha/Painel/Conteudo"]
